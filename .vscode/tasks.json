{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev server",
            // Run npm.cmd directly: PowerShell blocks npm.ps1 under the default script policy.
            "type": "process",
            "command": "npm.cmd",
            "args": ["run", "dev"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": { "regexp": "^__never_matches__$" },
                "background": {
                    "activelyMatching": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "stop dev server",
            "command": "${input:terminateDevServer}"
        }
    ],
    "inputs": [
        {
            "id": "terminateDevServer",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "dev server"
        }
    ]
}
